"""Payload contracts for the exported pipeline.

Generated by AthanorIDE from nodes:
{% for node_id in source_node_trace -%}
- {{ node_id }}
{% endfor %}
"""

from __future__ import annotations

from typing import Literal

from pydantic import BaseModel, Field


class RunRequest(BaseModel):
    text: str | None = Field(
        default=None,
        description="Optional override for the Text Input node value.",
    )


class RunResponse(BaseModel):
    input_text: str
    output_text: str
    transform_kind: Literal["uppercase", "lowercase", "strip", "identity"]
    instruction: str
    trace_node_ids: list[str]
    uses_compiled_transform: bool = False


class HealthResponse(BaseModel):
    status: Literal["ok"] = "ok"
    service: str
