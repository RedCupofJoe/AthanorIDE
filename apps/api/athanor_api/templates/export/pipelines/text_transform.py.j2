"""Text transformation pipeline.

Generated by AthanorIDE from nodes:
{% for node_id in source_node_trace -%}
- {{ node_id }}
{% endfor %}

{% if uses_compiled_transform -%}
Uses Phase 3 sandboxed NL compiler output stored on the transform node.
{% else -%}
Uses Phase 2 deterministic instruction classifier fallback.
{% endif -%}
"""

from __future__ import annotations

from typing import Literal

TransformKind = Literal["uppercase", "lowercase", "strip", "identity"]

INSTRUCTION = {{ primary_instruction | tojson }}
TRANSFORM_KIND: TransformKind = {{ primary_transform_kind | tojson }}
TRACE_NODE_IDS = {{ source_node_trace | tojson }}
USES_COMPILED_TRANSFORM = {{ uses_compiled_transform }}


{% if uses_compiled_transform -%}
# --- Begin compiled transform ---
{{ primary_compiled_code }}
# --- End compiled transform ---


def apply_transform(text: str, kind: TransformKind = TRANSFORM_KIND) -> str:
    del kind
    return transform(text)
{% else -%}
def apply_transform(text: str, kind: TransformKind = TRANSFORM_KIND) -> str:
    if kind == "uppercase":
        return text.upper()
    if kind == "lowercase":
        return text.lower()
    if kind == "strip":
        return text.strip()
    return text
{% endif %}


def run_pipeline(text: str) -> dict[str, object]:
    output = apply_transform(text)
    return {
        "input_text": text,
        "output_text": output,
        "transform_kind": TRANSFORM_KIND,
        "instruction": INSTRUCTION,
        "trace_node_ids": list(TRACE_NODE_IDS),
        "uses_compiled_transform": USES_COMPILED_TRANSFORM,
    }
