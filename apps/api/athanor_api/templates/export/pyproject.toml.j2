# Generated by AthanorIDE from nodes:
{% for node_id in source_node_trace -%}
# - {{ node_id }}
{% endfor %}
[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name | replace('\"', '\\\"') }}"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
  "fastapi>=0.115.0",
  "uvicorn[standard]>=0.34.0",
  "pydantic>=2.10.0",
  "pydantic-settings>=2.8.0",
{% if has_http_clients %}
  "httpx>=0.28.0",
{% endif %}
]

[project.optional-dependencies]
dev = [
  "httpx>=0.28.0",
  "pytest>=8.3.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app", "pipelines"]

[tool.pytest.ini_options]
testpaths = ["tests"]
