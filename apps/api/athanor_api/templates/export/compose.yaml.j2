# Generated by AthanorIDE from nodes:
{% for node_id in source_node_trace -%}
# - {{ node_id }}
{% endfor %}
# Local secrets: create .env via AthanorIDE Local vault → Materialize .env
# (never commit .env; export ZIPs only include .env.example).
services:
  app:
    build:
      context: .
      dockerfile: Containerfile
    ports:
      - "8080:8080"
    env_file:
      - path: .env
        required: false
    environment:
      APP_NAME: {{ project_slug }}
      DEFAULT_TEXT: {{ default_text | tojson }}
    healthcheck:
      test:
        [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health')",
        ]
      interval: 10s
      timeout: 5s
      retries: 5
