# Generated by AthanorIDE — Terraform for Kubernetes deployment
terraform {
  required_version = ">= 1.5.0"
  required_providers {
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = ">= 2.29.0"
    }
  }
}

provider "kubernetes" {
  # Configure via KUBECONFIG or CI credentials. Never commit cluster secrets.
  config_path = var.kubeconfig_path
}

variable "kubeconfig_path" {
  type        = string
  description = "Path to kubeconfig (local or CI)."
  default     = "~/.kube/config"
}

variable "image_tag" {
  type        = string
  description = "Container image tag to deploy."
  default     = "latest"
}

{% if deployment.primary_target %}
locals {
  namespace = {{ deployment.primary_target.namespace | tojson }}
  app_name  = {{ project_slug | tojson }}
}

resource "kubernetes_namespace" "app" {
  metadata {
    name = local.namespace
    labels = {
      "app.kubernetes.io/name" = local.app_name
    }
  }
}

resource "kubernetes_config_map" "app" {
  metadata {
    name      = "${local.app_name}-config"
    namespace = kubernetes_namespace.app.metadata[0].name
  }

  data = {
    APP_NAME     = local.app_name
    APP_HOST     = "0.0.0.0"
    APP_PORT     = {{ deployment.container_port | tojson }}
    DEFAULT_TEXT = {{ default_text | tojson }}
{% for item in deployment.env_vars %}
    {{ item.name }} = {{ item.example_value | tojson }}
{% endfor %}
  }
}

{% if deployment.secrets %}
resource "kubernetes_secret" "app" {
  metadata {
    name      = "${local.app_name}-secrets"
    namespace = kubernetes_namespace.app.metadata[0].name
    annotations = {
      "athanor.dev/secret-policy" = "values-must-be-injected-at-deploy-time"
    }
  }

  data = {
{% for item in deployment.secrets %}
    {{ item.env_key }} = ""
{% endfor %}
  }

  type = "Opaque"

  lifecycle {
    ignore_changes = [data]
  }
}
{% endif %}

resource "kubernetes_deployment" "app" {
  metadata {
    name      = local.app_name
    namespace = kubernetes_namespace.app.metadata[0].name
    labels = {
      "app.kubernetes.io/name" = local.app_name
    }
  }

  spec {
    replicas = 1
    selector {
      match_labels = {
        "app.kubernetes.io/name" = local.app_name
      }
    }
    template {
      metadata {
        labels = {
          "app.kubernetes.io/name" = local.app_name
        }
      }
      spec {
        container {
          name  = "app"
          image = "${local.app_name}:${var.image_tag}"
          port {
            name           = "http"
            container_port = {{ deployment.container_port }}
          }
          env_from {
            config_map_ref {
              name = kubernetes_config_map.app.metadata[0].name
            }
          }
{% if deployment.secrets %}
          env_from {
            secret_ref {
              name = kubernetes_secret.app.metadata[0].name
            }
          }
{% endif %}
          resources {
            requests = {
              cpu    = {{ deployment.primary_target.resources.cpu_request | tojson }}
              memory = {{ deployment.primary_target.resources.memory_request | tojson }}
            }
            limits = {
              cpu    = {{ deployment.primary_target.resources.cpu_limit | tojson }}
              memory = {{ deployment.primary_target.resources.memory_limit | tojson }}
            }
          }
          security_context {
            allow_privilege_escalation = false
            read_only_root_filesystem  = true
            run_as_non_root            = true
          }
        }
      }
    }
  }
}

resource "kubernetes_service" "app" {
  metadata {
    name      = local.app_name
    namespace = kubernetes_namespace.app.metadata[0].name
  }
  spec {
    selector = {
      "app.kubernetes.io/name" = local.app_name
    }
    port {
      name        = "http"
      port        = {{ deployment.container_port }}
      target_port = "http"
    }
  }
}

resource "kubernetes_network_policy" "default_deny" {
  metadata {
    name      = "${local.app_name}-default-deny"
    namespace = kubernetes_namespace.app.metadata[0].name
  }
  spec {
    pod_selector {
      match_labels = {
        "app.kubernetes.io/name" = local.app_name
      }
    }
    policy_types = ["Ingress", "Egress"]
    ingress {
      ports {
        port     = {{ deployment.container_port }}
        protocol = "TCP"
      }
    }
    egress {
      ports {
        port     = 53
        protocol = "UDP"
      }
    }
  }
}

output "namespace" {
  value = kubernetes_namespace.app.metadata[0].name
}

output "service_name" {
  value = kubernetes_service.app.metadata[0].name
}
{% endif %}
