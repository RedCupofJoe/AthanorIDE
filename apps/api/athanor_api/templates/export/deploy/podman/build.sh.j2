#!/usr/bin/env bash
# Generated by AthanorIDE — Podman build helper for {{ project_slug }}
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
IMAGE_NAME="${IMAGE_NAME:-{{ project_slug }}}"
IMAGE_TAG="${IMAGE_TAG:-latest}"
IMAGE_REF="${IMAGE_REF:-${IMAGE_NAME}:${IMAGE_TAG}}"
PUSH=0

for arg in "$@"; do
  case "$arg" in
    --push) PUSH=1 ;;
    -h|--help)
      echo "Usage: $0 [--push]"
      echo "  IMAGE_NAME / IMAGE_TAG / IMAGE_REF override the image reference."
      exit 0
      ;;
  esac
done

cd "$ROOT"
echo "Building ${IMAGE_REF} with Podman…"
podman build -t "${IMAGE_REF}" -f Containerfile .

if [[ "${PUSH}" -eq 1 ]]; then
  echo "Pushing ${IMAGE_REF}…"
  podman push "${IMAGE_REF}"
fi

echo "Done. Run: podman run --rm -p 8080:8080 ${IMAGE_REF}"
