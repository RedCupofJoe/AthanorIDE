apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ project_slug }}-{{ target.namespace }}
  namespace: argocd
  labels:
    app.kubernetes.io/name: {{ project_slug }}
    athanor.dev/environment: {{ target.kind }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: {{ project_slug }}
  source:
    # REPLACE with your Git remote that contains this exported repository
    repoURL: https://git.example.com/{{ project_slug }}.git
    targetRevision: HEAD
    path: {{ app_path }}
