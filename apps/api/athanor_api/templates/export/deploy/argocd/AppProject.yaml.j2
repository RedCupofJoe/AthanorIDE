apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: {{ project_slug }}
  namespace: argocd
  labels:
    app.kubernetes.io/name: {{ project_slug }}
spec:
  description: AthanorIDE exported project {{ project_name }}
  sourceRepos:
    # REPLACE with your Git remote after pushing this export
    - https://git.example.com/{{ project_slug }}.git
    - '*'
  destinations:
    - namespace: '*'
      server: https://kubernetes.default.svc
  sourceNamespaces:
    - argocd
  clusterResourceWhitelist:
    - group: ''
      kind: Namespace
  namespaceResourceWhitelist:
    - group: '*'
      kind: '*'
