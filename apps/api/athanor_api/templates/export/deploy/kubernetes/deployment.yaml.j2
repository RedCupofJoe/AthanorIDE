# Generated by AthanorIDE from nodes:
{% for node_id in source_node_trace -%}
# - {{ node_id }}
{% endfor %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ project_slug }}
  namespace: {{ target.namespace }}
  labels:
    app.kubernetes.io/name: {{ project_slug }}
    athanor.dev/environment: {{ target.kind }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ project_slug }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ project_slug }}
        athanor.dev/environment: {{ target.kind }}
    spec:
      containers:
        - name: app
          image: {{ deployment.image_name }}:latest
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: {{ deployment.container_port }}
          envFrom:
            - configMapRef:
                name: {{ project_slug }}-config
{% if deployment.secrets %}
            - secretRef:
                name: {{ project_slug }}-secrets
{% endif %}
          resources:
            requests:
              cpu: {{ target.resources.cpu_request | tojson }}
              memory: {{ target.resources.memory_request | tojson }}
{% if target.resources.gpu > 0 %}
              nvidia.com/gpu: {{ target.resources.gpu | tojson }}
{% endif %}
            limits:
              cpu: {{ target.resources.cpu_limit | tojson }}
              memory: {{ target.resources.memory_limit | tojson }}
{% if target.resources.gpu > 0 %}
              nvidia.com/gpu: {{ target.resources.gpu | tojson }}
{% endif %}
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop: ["ALL"]
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
