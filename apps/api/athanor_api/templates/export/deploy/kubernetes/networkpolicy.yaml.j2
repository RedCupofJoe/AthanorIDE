# Generated by AthanorIDE — default-deny plus explicit allowed ports
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ project_slug }}-netpol
  namespace: {{ target.namespace }}
  labels:
    app.kubernetes.io/name: {{ project_slug }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: {{ project_slug }}
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: {{ project_slug }}
      ports:
        - protocol: TCP
          port: {{ deployment.container_port }}
{% for rule in deployment.network_policies if rule.direction == 'ingress' %}
    - ports:
{% for port in rule.ports %}
        - protocol: TCP
          port: {{ port }}
{% endfor %}
{% endfor %}
  egress:
    - to:
        - namespaceSelector: {}
      ports:
        - protocol: UDP
          port: 53
{% for rule in deployment.network_policies if rule.direction == 'egress' %}
    - ports:
{% for port in rule.ports %}
        - protocol: TCP
          port: {{ port }}
{% endfor %}
{% endfor %}
