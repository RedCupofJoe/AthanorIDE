# Generated by AthanorIDE — ConfigMap (non-secret configuration only)
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ project_slug }}-config
  namespace: {{ target.namespace }}
  labels:
    app.kubernetes.io/name: {{ project_slug }}
data:
  APP_NAME: {{ project_slug | tojson }}
  APP_HOST: "0.0.0.0"
  APP_PORT: "{{ deployment.container_port }}"
  DEFAULT_TEXT: {{ default_text | tojson }}
{% for item in deployment.env_vars %}
  {{ item.name }}: {{ item.example_value | tojson }}
{% endfor %}
