# Generated by AthanorIDE — BuildConfig from repo Containerfile
# Point source.git.uri at your published Git repo after export.
apiVersion: build.openshift.io/v1
kind: BuildConfig
metadata:
  name: {{ project_slug }}
  namespace: {{ target.namespace }}
  labels:
    app.kubernetes.io/name: {{ project_slug }}
    athanor.dev/environment: {{ target.kind }}
spec:
  output:
    to:
      kind: ImageStreamTag
      name: {{ project_slug }}:latest
  source:
    type: Git
    git:
      # REPLACE with your Git remote that contains this exported repository
      uri: https://git.example.com/{{ project_slug }}.git
      ref: main
    contextDir: /
  strategy:
    type: Docker
    dockerStrategy:
      dockerfilePath: Containerfile
  triggers:
    - type: ConfigChange
  runPolicy: Serial
