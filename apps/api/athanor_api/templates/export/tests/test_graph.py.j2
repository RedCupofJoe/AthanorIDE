from __future__ import annotations

import json
from pathlib import Path

from pipelines.text_transform import TRACE_NODE_IDS


def test_generated_graph_matches_trace() -> None:
    graph_path = Path(__file__).resolve().parents[1] / "docs" / "generated-graph.json"
    document = json.loads(graph_path.read_text(encoding="utf-8"))
    assert document["schemaVersion"] == {{ schema_version | tojson }}
    node_ids = [node["id"] for node in document["nodes"]]
    for node_id in TRACE_NODE_IDS:
        assert node_id in node_ids
