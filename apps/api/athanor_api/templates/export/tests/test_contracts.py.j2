from __future__ import annotations

from app.contracts import RunRequest, RunResponse
from pipelines.text_transform import TRANSFORM_KIND, apply_transform, run_pipeline


def test_run_request_accepts_optional_text() -> None:
    payload = RunRequest()
    assert payload.text is None


def test_pipeline_applies_classified_transform() -> None:
    sample = "Hello World"
    result = run_pipeline(sample)
    assert result["input_text"] == sample
    assert result["output_text"] == apply_transform(sample, TRANSFORM_KIND)
    assert result["transform_kind"] == TRANSFORM_KIND
    response = RunResponse.model_validate(result)
    assert response.output_text == result["output_text"]
