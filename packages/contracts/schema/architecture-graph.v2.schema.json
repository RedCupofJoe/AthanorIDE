{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athanor.dev/schemas/architecture-graph/v2.json",
  "title": "AthanorIDE Architecture Graph",
  "description": "Canonical persisted project document for AthanorIDE. Schema version 2.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "nodes",
    "edges",
    "viewport",
    "workflow"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "project": {
      "$ref": "#/$defs/ProjectMetadata"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArchitectureNode"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArchitectureEdge"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataContract"
      },
      "default": []
    },
    "deploymentEnvironments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DeploymentEnvironment"
      },
      "default": []
    },
    "macroBlocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MacroBlock"
      },
      "default": []
    },
    "portalBuses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PortalBus"
      },
      "default": []
    },
    "infrastructureTokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InfrastructureTokenSlot"
      },
      "default": [],
      "description": "Project-level infrastructure pull-token slots (secret names only)."
    },
    "validationResults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "default": []
    },
    "exportConfiguration": {
      "$ref": "#/$defs/ExportConfiguration"
    },
    "viewport": {
      "$ref": "#/$defs/Viewport"
    },
    "workflow": {
      "$ref": "#/$defs/Workflow"
    }
  },
  "$defs": {
    "ProjectMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "ContractType": {
      "type": "string",
      "enum": [
        "STRING",
        "PROMPT",
        "MODEL_HANDLE",
        "MODEL_WEIGHTS",
        "VECTOR_EMBEDDING",
        "DATABASE_HANDLE",
        "TOOL_DEFINITION",
        "MCP_SERVER",
        "SANDBOX_POLICY",
        "SANDBOX_RUNTIME",
        "GUARDRAIL",
        "MCP_RESOURCE",
        "MCP_PROMPT",
        "STREAMING_PAYLOAD",
        "JSON_SCHEMA",
        "IMAGE",
        "VIDEO",
        "AUDIO",
        "TENSOR",
        "FILE_REFERENCE",
        "DATASET",
        "EVENT",
        "ANY"
      ]
    },
    "NodePort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "direction",
        "contractType",
        "required",
        "multiple"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "input",
            "output"
          ]
        },
        "contractType": {
          "$ref": "#/$defs/ContractType"
        },
        "required": {
          "type": "boolean"
        },
        "multiple": {
          "type": "boolean"
        },
        "schema": {
          "type": "object"
        }
      }
    },
    "ArchitectureNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "version",
        "name",
        "position",
        "configuration",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "configuration": {
          "type": "object"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodePort"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodePort"
          }
        },
        "deploymentTarget": {
          "type": "string"
        },
        "parentMacroId": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "workflowTaskId": {
          "type": "string",
          "minLength": 1
        },
        "instructionMode": {
          "enum": [
            "inherit",
            "override"
          ]
        },
        "prunedPorts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "inputs",
            "outputs"
          ]
        }
      }
    },
    "ArchitectureEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceNodeId",
        "sourcePortId",
        "targetNodeId",
        "targetPortId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceNodeId": {
          "type": "string",
          "minLength": 1
        },
        "sourcePortId": {
          "type": "string",
          "minLength": 1
        },
        "targetNodeId": {
          "type": "string",
          "minLength": 1
        },
        "targetPortId": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "DataContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contractType",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "contractType": {
          "$ref": "#/$defs/ContractType"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "DeploymentEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "LOCAL_WORKSTATION",
            "ON_PREMISES",
            "OPENSHIFT",
            "KUBERNETES",
            "AWS_GPU",
            "GCP_CLOUD_RUN",
            "AZURE_CONTAINER_APPS",
            "EDGE_DEVICE",
            "RASPBERRY_PI",
            "AIR_GAPPED_ENVIRONMENT"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "MacroBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "nodeIds",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodePort"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodePort"
          }
        },
        "collapsed": {
          "type": "boolean",
          "default": true
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "PortalBus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "busId",
        "displayName",
        "contractType",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "busId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "contractType": {
          "$ref": "#/$defs/ContractType"
        },
        "scope": {
          "type": "string",
          "enum": [
            "project",
            "macro",
            "deployment"
          ]
        },
        "scopeId": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "InfrastructureTokenSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "secretName"
      ],
      "description": "Infrastructure registry pull credential reference (name only, never the token value).",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "huggingface",
            "kaggle",
            "docker",
            "github",
            "uci_ml",
            "pytorch_hub",
            "custom"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "secretName": {
          "type": "string",
          "description": "Environment/vault secret name. Never store the token value here."
        },
        "provider": {
          "type": "string",
          "enum": [
            "env",
            "file",
            "vault",
            "cloud_secret_manager"
          ],
          "default": "env"
        },
        "recommendedEnvName": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "ValidationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "edgeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "suggestedAction": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "transitionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "portId": {
          "type": [
            "string",
            "null"
          ]
        },
        "fieldPath": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ExportConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectSlug": {
          "type": "string"
        },
        "includeDockerCompat": {
          "type": "boolean",
          "default": false
        },
        "includeKubernetes": {
          "type": "boolean",
          "default": false
        },
        "includeOpenShift": {
          "type": "boolean",
          "default": false
        },
        "includeTerraform": {
          "type": "boolean",
          "default": false
        },
        "includeArgoCd": {
          "type": "boolean",
          "default": false
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "Viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "WorkflowBounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 240
        },
        "height": {
          "type": "number",
          "minimum": 180
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "WorkflowBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "portId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "nodeId",
        "portId"
      ]
    },
    "WorkflowTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "role": {
          "type": "string"
        },
        "expectedTasks": {
          "type": "string"
        },
        "constraints": {
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/WorkflowBounds"
        },
        "engineeringBounds": {
          "$ref": "#/$defs/WorkflowBounds"
        },
        "inputBinding": {
          "$ref": "#/$defs/WorkflowBinding"
        },
        "outputBinding": {
          "$ref": "#/$defs/WorkflowBinding"
        }
      },
      "required": [
        "id",
        "name",
        "color",
        "role",
        "expectedTasks",
        "constraints",
        "bounds",
        "engineeringBounds"
      ]
    },
    "WorkflowTransition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceTaskId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "targetTaskId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "normal",
            "recovery"
          ]
        },
        "stage": {
          "type": "integer",
          "minimum": 1
        },
        "recoveryDescription": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sourceTaskId",
        "targetTaskId",
        "kind",
        "stage",
        "recoveryDescription"
      ]
    },
    "Workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkflowTask"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkflowTransition"
          }
        },
        "input": {
          "type": "string"
        },
        "maxParallelTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        }
      },
      "required": [
        "tasks",
        "transitions",
        "input",
        "maxParallelTasks",
        "viewport"
      ]
    }
  }
}
